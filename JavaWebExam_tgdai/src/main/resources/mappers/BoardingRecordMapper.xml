        UPDATE boarding_records
        SET actual_check_out = #{actualCheckOut},
            base_fee = #{baseFee},
            late_fee = #{lateFee},
            total_fee = #{totalFee},
            status = 'RETURNED'
        WHERE id = #{id}
    </update>-->

    <select id="getActiveBoardingRecords" resultMap="FullBoardingRecordMap">
        <include refid="SelectBoardingBase"/>
        WHERE b.status = 'BOARDING'
        ORDER BY b.id DESC
    </select>

    <select id="getRecordsByPetId" parameterType="map" resultMap="FullBoardingRecordMap">
        <include refid="SelectBoardingBase"/>
        WHERE b.pet_id = #{petId}
        ORDER BY b.id DESC
    </select>

    <select id="getRecordsByOwnerId" parameterType="map" resultMap="FullBoardingRecordMap">
        <include refid="SelectBoardingBase"/>
        WHERE o.id = #{ownerId}
        ORDER BY b.id DESC
    </select>

    <select id="searchByDateRange" parameterType="map" resultMap="FullBoardingRecordMap">
        <include refid="SelectBoardingBase"/>
        <where>
        	<if test="fromDate != null">
        		b.check_in_date &gt;= #{fromDate}
        	</if>
        	<if test="toDate != null">
        		AND b.check_in_date &lt;= #{toDate}
        	</if>
        </where>
        ORDER BY b.id DESC
    </select>
<!--TODO: this method isn't finish yet (waiting for adding security)-->
<!--    <select id="getActiveRecordsByOwnerId" parameterType="map" resultMap="FullBoardingRecordMap">
        <include refid="SelectBoardingBase"/>
        WHERE o.id = #{ownerId} AND b.status = 'BOARDING'
        ORDER BY b.id DESC
    </select>-->

    <select id="filterBoardingRecords" parameterType="map" resultMap="FullBoardingRecordMap">
        <include refid="SelectBoardingBase"/>
        <where>
            <if test="status != null and status != ''">
                LOWER(b.status) = LOWER(#{status})
            </if>
            <if test="type != null and type != ''">
                AND LOWER(p.type) = LOWER(#{type})
            </if>
            <if test="ownerId != null">
                AND o.id = #{ownerId}
            </if>
            <if test="fromDate != null">
                AND b.check_in_date &gt;= #{fromDate}
            </if>
            <if test="toDate != null">
                AND b.check_in_date &lt;= #{toDate}
            </if>
        </where>
        ORDER BY b.id DESC
    </select>

</mapper>