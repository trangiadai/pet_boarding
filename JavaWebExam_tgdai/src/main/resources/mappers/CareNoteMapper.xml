<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="training.javaweb.exam.dao.mapper.CareNoteMapper">

	<insert id="createCareNote" parameterType="map" useGeneratedKeys="true" keyProperty="id">
		INSERT INTO care_notes (boarding_record_id, note)
		VALUES (
			#{boardingRecordId}, 
			#{note}
		)
	</insert>

	<select id="getCareNotesByBoardingRecordId" parameterType="map" resultType="training.javaweb.exam.entity.CareNote">
		SELECT 
			id, 
			boarding_record_id AS boardingRecordId, 
			note, 
			created_at AS createdAt
		FROM care_notes
		WHERE boarding_record_id = #{boardingRecordId}
		ORDER BY created_at DESC
	</select>

</mapper>